    <nav class="nav" id="nav" aria-label="Hlavní navigace">
      <ul class="nav__list">
        <li><a class="nav__link" href="#proc-ems">Proč EMS</a></li>
        <li><a class="nav__link" href="#cenik">Ceník</a></li>
        <li><a class="nav__link" href="#prvni-lekce">První lekce</a></li>
        <li><a class="nav__link" href="#o-mne">O mně</a></li>
        <li><a class="nav__link" href="#kontakt">Kontakt</a></li>
      </ul>
      <div class="nav__cta"><a class="btn btn--primary btn--sm" href="{{ site.reservio_url }}" target="_blank" rel="noopener noreferrer">Vytvořit rezervaci</a></div>
    </nav>

    <a class="btn btn--primary btn--sm btn--header" href="{{ site.reservio_url }}" target="_blank" rel="noopener noreferrer">Vytvořit rezervaci</a>
  </div>
</header>
