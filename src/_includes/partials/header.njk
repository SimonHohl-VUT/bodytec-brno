<header class="header" id="header">
  <div class="wrap header__inner">
    <a class="logo" href="#uvod" aria-label="{{ site.nazev }} — domů">
      {% include "partials/logo.njk" %}
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Otevřít menu">
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
