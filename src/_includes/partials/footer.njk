<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="logo" href="#uvod">
          {% include "partials/logo.njk" %}
        </a>
        <p>EMS studio v centru Brna. Celé tělo za 20 minut jednou týdně, vždy jeden na jednoho s trenérem.</p>
      </div>

      <div>
        <h3>Kontakt</h3>
        <ul>
          <li>{{ site.adresa.ulice }}, {{ site.adresa.mesto }}, {{ site.adresa.psc }}</li>
          <li><a href="tel:{{ site.telefon.odkaz }}">{{ site.telefon.text }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        </ul>
      </div>

      <div>
        <h3>Sekce</h3>
        <ul>
          <li><a href="#proc-ems">Proč EMS</a></li>
          <li><a href="#cenik">Ceník</a></li>
          <li><a href="#prvni-lekce">První lekce</a></li>
          <li><a href="#o-mne">O mně</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© <span id="year">2026</span> {{ site.nazev }}, {{ site.majitel }}</p>
      <p>Číslo účtu: {{ site.cislo_uctu }}</p>
    </div>
  </div>
</footer>
