<section class="section section--light" id="cenik">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Ceník</p>
      <h2>Jasné ceny, žádné členské poplatky</h2>
      <p class="lead">Plať za jednotlivé lekce, nebo si pořiď permanentku — čím víc vstupů, tím nižší cena za lekci.</p>
    </div>

    <table class="price-table">
      <caption class="sr-only">Ceník vstupů a permanentek</caption>
      <thead>
        <tr>
          <th scope="col">Položka</th>
          <th scope="col">Platnost</th>
          <th scope="col">Cena</th>
          <th scope="col">Cena za lekci</th>
        </tr>
      </thead>
      <tbody>
{%- for polozka in cenik.polozky %}
        <tr{% if polozka.zvyraznit %} class="is-featured"{% endif %}>
          <td class="p-item">{{ polozka.nazev }}</td>
          <td class="p-valid{% if not polozka.platnost %} is-empty{% endif %}" data-label="Platnost">{{ polozka.platnost if polozka.platnost else "—" }}</td>
          <td class="p-price{% if not polozka.cena %} is-empty{% endif %}" data-label="Cena">{{ polozka.cena if polozka.cena else "—" }}</td>
          <td class="p-unit{% if not polozka.za_lekci %} is-empty{% endif %}" data-label="Cena za lekci">{{ polozka.za_lekci if polozka.za_lekci else "—" }}</td>
        </tr>
{%- endfor %}
      </tbody>
    </table>

    <div class="price-foot">
      <p>Storno poplatek při zrušení méně než 24 hodin předem: <strong>{{ cenik.storno }}</strong></p>
      <p>Ceny platné od <strong>{{ cenik.platne_od }}</strong></p>
    </div>

    <div class="price-notes">
      <div class="note">
        <h3>{{ cenik.poznamky.prevod.nadpis }}</h3>
        <p>{{ cenik.poznamky.prevod.text | safe }}<br><strong>{{ site.cislo_uctu }}</strong></p>
      </div>
      <div class="note">
        <h3>{{ cenik.poznamky.benefitky.nadpis }}</h3>
        <p>{{ cenik.poznamky.benefitky.text | safe }}</p>
      </div>
      <div class="note">
        <h3>{{ cenik.poznamky.multisport.nadpis }}</h3>
        <p>{{ cenik.poznamky.multisport.text | safe }}</p>
      </div>
    </div>
  </div>
</section>
